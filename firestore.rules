rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to check for admin claim or recognized admin emails
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        request.auth.token.email in [
          'admin@pamborina.com',
          'mentalitym254@gmail.com'
        ] ||
        request.auth.token.email.matches('.*@pamborina[.]com$')
      );
    }

    // Categories Collection
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Products Collection
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Branches Collection
    match /branches/{branchId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Settings Collection & Order Sequences
    match /settings/orderSequences {
      allow read: if true;
      allow write: if isAdmin() || (
        request.resource.data.resetting == false &&
        (!resource.data.keys().hasAny(['resetting']) || resource.data.resetting == false)
      );
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Hero Offers & Menus & Paper Menu Pages
    match /offers/{offerId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /hero_offers/{offerId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /menus/{menuId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /paper_menu_pages/{pageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders Collection
    match /orders/{orderId} {
      allow read: if true;
      allow create: if request.resource.data.items is list && request.resource.data.items.size() > 0;
      allow update, delete: if isAdmin();
    }

    // Audit Logs Collection
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Archived Orders Collection
    match /archivedOrders/{orderId} {
      allow read, write: if isAdmin();
    }

    // Default Fallback Rule
    match /{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
